# Server
APP_ENV=development
LOG_LEVEL=INFO
# For single-project Vercel, frontend and API share a domain. Retain local
# development origins here; only add an external frontend URL if you split them.
API_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
REQUEST_MAX_BYTES=32768

# Local Docker/development persistence. Vercel Functions use Supabase Postgres
# with pgvector instead of local files.
DATA_DIR=./data
CHROMA_COLLECTION=real_estate_documents
# Leave empty to derive SQLite path from DATA_DIR.
DATABASE_URL=
VECTOR_STORE=chroma

# Vercel production persistence: set these values in Vercel's Environment
# Variables. Supabase's direct connection string must use the SQLAlchemy
# `postgresql+psycopg://` scheme and have pgvector enabled.
# VECTOR_STORE=pgvector
# Example: postgresql+psycopg://user:password@host/database?sslmode=require
# DATABASE_URL=
# RAG
# Local/Docker uses Sentence Transformers. Vercel uses the free OpenRouter
# embedding model configuration shown in the deployment section below.
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=1100
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.32
CONVERSATION_HISTORY_LIMIT=8

# OpenRouter. Do not commit a real API key.
OPENROUTER_API_KEY=
# `openrouter/free` is OpenRouter's live free-model router. A fixed model may be
# supplied after it is validated against https://openrouter.ai/api/v1/models.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_SECONDS=35
# Vercel production embedding configuration (same backend-only API key):
# EMBEDDING_PROVIDER=openrouter
# EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b:free
# EMBEDDING_DIMENSION=2048

# Respectful crawling controls
SCRAPER_USER_AGENT=DarGlobalWasaltResearchBot/1.0 (+https://github.com/your-org/real-estate-ai-assistant)
SCRAPER_DELAY_SECONDS=1.5
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_PAGES_PER_SOURCE=25
